  "cards": [
    {
      "dot": "slate",
      "title": "Scope and limits",
      "items": [
        "Sources are the submitted X post and selected social search results; Reddit is explicitly unsupported.",
        "Replies are public opinions, displayed as text with original post links; reply media is not fetched.",
        "Opening or refreshing the panel reads the owner-scoped cache. No automatic paid retry, including uncertain outcomes."
      ]
    },
    {
      "dot": "amber",
      "title": "Privacy and rollout",
      "items": [
        "Admission checks the verified owner, a completed unexpired item and persisted source membership.",
        "URL aliases share one admission; deletion cascades cached replies and fences late writes.",
        "Migration 000018 precedes backend and frontend deployment. This is a behavior contract, not repository snapshot proof."
      ]
    }
