  "cards": [
    {
      "dot": "cyan",
      "title": "Search conditions",
      "items": [
        "The submitted allowance defaults to one for old clients; the updated disclosure requests two.",
        "Only a confirmed first search and an explicit remaining evidence gap allow refinement.",
        "Repeated queries stop; uncertain searches disable further research. No third search."
      ]
    },
    {
      "dot": "amber",
      "title": "Budget and evidence",
      "items": [
        "Each model/search slot reserves once under the owner budget lock. No provider retry or fallback.",
        "Each search fetches up to 20 safe URLs; partial pages and snippets are not evidence.",
        "The final generation either answers from available evidence or discloses insufficiency.",
        "New turns have an eight-minute deadline. Hosted migration and live quality remain separate."
      ]
    }
