  "cards": [
    {
      "dot": "cyan",
      "title": "Implementation contract",
      "items": [
        "This diagram describes the local code contract, not hosted activation.",
        "SSE requires an owner session and restores durable state after disconnection.",
        "The result is saved before cost settlement; final publication requires a lease."
      ]
    },
    {
      "dot": "amber",
      "title": "Safe recovery",
      "items": [
        "Incomplete source content stops processing before the model call.",
        "The limit can be raised; resuming is an explicit user action.",
        "Unknown cost prevents another paid call for the same attempt.",
        "Interrupted local work recovers its lease without duplicate paid calls.",
        "Heartbeat: 15 s; lease: 60 s; 45 s without freshness shows a pause.",
        "The 0.14848 USD reservation covers the verified full context and output bound."
      ]
    }
