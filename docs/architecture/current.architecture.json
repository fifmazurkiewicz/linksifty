      "dot": "cyan",
      "title": "Editable account rules",
      "items": [
        "Eight fixed criterion IDs; descriptions up to 1000 characters; integer weights 1\u201310. One explicit settings save."
      ]
    },
    {
      "dot": "emerald",
      "title": "One analysis snapshot",
      "items": [
        "First model reservation locks settings and snapshots rubric with threshold. Model guidance and deterministic scoring use that same version. Recovery reuses it; detail displays it."
      ]
    },
    {
      "dot": "rose",
      "title": "Grounding and billing",
      "items": [
        "Complete source content is required before inference. Existing citation, corroboration and budget guards remain mandatory. No automatic paid retry. Legacy history retains default rules."
      ]
    }
