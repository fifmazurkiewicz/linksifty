  "cards": [
    {
      "dot": "cyan",
      "title": "Implemented CI",
      "items": [
        "Three independent jobs run on ubuntu-latest, each with a 15-minute timeout.",
        "No provider secrets, image publication, deployment job or migration runner.",
        "Agent-toolkit and database gates are separate from the current GitHub workflow."
      ]
    },
    {
      "dot": "amber",
      "title": "Operator procedure, not automated CD",
      "items": [
        "Select a revision and verify host auto-deploy settings before coordinating schema and code.",
        "Render and Vercel dashboard settings are not evidenced by repository configuration.",
        "Record release is the documented operator handoff, not an implemented workflow job."
      ]
    },
    {
      "dot": "rose",
      "title": "Failure handling",
      "items": [
        "Stop a release if a required gate fails. Health alone proves only process liveness.",
        "Restore compatible API/UI versions after an application failure.",
        "No automated down-migrations exist; preserve data and unresolved cost reservations."
      ]
    }
  ]
