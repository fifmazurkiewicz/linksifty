  "cards": [
    {
      "dot": "cyan",
      "title": "Hosting and execution",
      "items": [
        "Vercel hosts static assets; Render runs the API container.",
        "The bounded runner lives inside the API process, with durable database leases.",
        "Hosting topology is documented configuration, not a live deployment audit."
      ]
    },
    {
      "dot": "amber",
      "title": "Optional integrations",
      "items": [
        "Brave research needs consent, configuration and a budget reservation; Jev selects analysis sources.",
        "Resend sends account approval email after the status commit.",
        "Opt-in Langfuse traces can include redacted article and model content."
      ]
    },
    {
      "dot": "rose",
      "title": "Trust and recovery",
      "items": [
        "Every content operation stays scoped to the verified owner, including administrators.",
        "Only complete text can enter assessment; omitted media is disclosed.",
        "Unknown costs remain reserved; recovery does not blindly repeat paid calls."
      ]
    }
  ]
