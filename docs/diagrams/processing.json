  "cards": [
    {
      "dot": "cyan",
      "title": "Pipeline semantics",
      "items": [
        "Model results are saved for recovery; known costs settle before the final assessment is published.",
        "Research failure can fall back to the primary source; budget denial prevents the affected paid call.",
        "Invalid output never becomes an assessment, but a paid call still needs cost settlement."
      ]
    },
    {
      "dot": "rose",
      "title": "Recovery and manual action",
      "items": [
        "Partial preview is optional, admitted once, and never supplies an assessment score.",
        "Paste returns complete text to validation; Retry returns the same item to fetching when safe.",
        "A known generation ID enables reconciliation. Unknown outcomes are never automatically resent.",
        "An unknown model cost stops processing before assessment validation/publication and requires reconciliation."
      ]
    }
  ]
