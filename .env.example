SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
X_API_BEARER_TOKEN=
# Operator approval for potentially billed X reads, outside the model/Brave budget.
X_API_READS_ENABLED=false
LINKSIFTY_DEMO_MODE=false
FRONTEND_ORIGIN=
LINKSIFTY_ADMIN_EMAIL=
RESEND_API_KEY=
