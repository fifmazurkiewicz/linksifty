# Public browser configuration. These values are included in the Vite bundle.
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only search and observability (enabled tracing includes redacted article/model content). Empty key or zero price disables Brave.
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_PRICE_PER_REQUEST_USD=0
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=production
